# Copier vers .env pour personnaliser (optionnel : tout a une valeur par défaut)

# UID utilisé par les conteneurs Airflow (sous Linux : mettre `id -u`)
AIRFLOW_UID=50000

# Compte admin de l'UI Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Ports exposés en local
AIRFLOW_PORT=8080
API_PORT=8000
FRONTEND_PORT=3000

# Départements traités par le pipeline (codes INSEE, séparés par des virgules)
DEPARTEMENTS=06

# Webhook Slack/Discord appelé à chaque échec de tâche du DAG (optionnel)
ALERT_WEBHOOK_URL=

# Années DVF à ingérer. Par défaut : de DVF_ANNEE_DEBUT à l'année en cours.
# DVF_ANNEES=2021,2022,2023 force une liste précise.
DVF_ANNEE_DEBUT=2021
DVF_ANNEES=

# Alerte Telegram à chaque échec du DAG (optionnel) : jeton du bot (@BotFather)
# et identifiant de la conversation. Test : make test-alerte
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
